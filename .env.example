# Copy to .env in the client repository root and replace the placeholders.
# Principal and server visual requests share this service URL and credential.
SKYNET_BASE_URL=https://model-service.example/v1
SKYNET_API_KEY=replace-with-your-service-credential

# Principal model must support tools; positive finite request timeout (sample).
# If using baseline architecture, this model must also accept images.
ARCHITECTURE_AGENT_MODEL=replace-with-deployed-principal-model
ARCHITECTURE_AGENT_TIMEOUT_SECONDS=600

# Server visual model must accept images; positive finite timeout (sample).
VISUAL_INSPECTION_MODEL=replace-with-deployed-visual-model
VISUAL_INSPECTION_TIMEOUT_SECONDS=600

# Absolute paths to a separately installed server; do not put a command here.
# Windows executable: C:/path/to/mcp-pdf-ingestion/.venv/Scripts/mcp-pdf-ingestion.exe
# Windows directory: C:/path/to/mcp-pdf-ingestion
MCP_PDF_SERVER_EXECUTABLE='/absolute/path/to/mcp-pdf-ingestion/.venv/bin/mcp-pdf-ingestion'
MCP_PDF_SERVER_CWD='/absolute/path/to/mcp-pdf-ingestion'

# Optional: required only when running retained baseline document conversion.
DOCUMENT_EXTRACTOR_MODEL=replace-with-deployed-nuextract3-model
DOCUMENT_EXTRACTOR_TIMEOUT_SECONDS=600
