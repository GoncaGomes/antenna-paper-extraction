# Copy to .env in the repository root and replace the service placeholders.
# Both model stages use this OpenAI-compatible endpoint and credential.
SKYNET_BASE_URL=https://model-service.example/v1
SKYNET_API_KEY=replace-with-your-service-credential

# Deployed NuExtract3 identifier and positive request timeout (sample value).
DOCUMENT_EXTRACTOR_MODEL=replace-with-deployed-nuextract3-model
DOCUMENT_EXTRACTOR_TIMEOUT_SECONDS=600

# Deployed model supporting tools and images; positive finite request timeout.
ARCHITECTURE_AGENT_MODEL=replace-with-deployed-architecture-model
ARCHITECTURE_AGENT_TIMEOUT_SECONDS=600
